# Expense Behaviour Analytical Platform (EBAP)
# Environment Configuration Template
# Copy this file to .env for local configuration overrides

# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/expense-behaviour-analytics

# Database Connection (Default XAMPP settings)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=expense_behaviour_analytics
DB_USER=root
DB_PASS=

# Session Security
SESSION_NAME=ebap_session
SESSION_SECURE_COOKIE=false

# Default Localization
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
